# Copy to .env and fill in. NEVER commit .env.

# --- Application ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
# Public HTTPS URL (must match shopify.app.toml)
APP_URL=https://logistics.example.com
LOG_LEVEL=INFO
LOG_JSON=true

# --- Shopify (Dev Dashboard -> your app -> Settings) ---------------------------------------
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_EXPIRING_OFFLINE_TOKENS=true
# Private app: only these shops may use it (comma-separated). Strongly recommended.
SHOPIFY_SHOP_ALLOWLIST=your-store.myshopify.com

# --- Infrastructure ------------------------------------------------------------------------
# docker-compose overrides these two for containers; set them for running outside Docker.
DATABASE_URL=postgresql+psycopg://trekiva:trekiva@localhost:5432/trekiva
REDIS_URL=redis://localhost:6379/0
# Used by docker-compose.prod.yml only:
POSTGRES_USER=trekiva
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trekiva

# --- Security ------------------------------------------------------------------------------
# Fernet key(s) encrypting Shopify tokens and carrier credentials at rest. First key encrypts;
# extra keys (comma-separated) still decrypt, for rotation. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
# Development only: authenticate admin API calls as this shop without a session token.
# DEV_AUTH_BYPASS_SHOP=your-dev-store.myshopify.com

# --- Carriers ------------------------------------------------------------------------------
# Mock carriers are always refused when APP_ENV=production.
ALLOW_MOCK_CARRIERS=true
CARRIER_HTTP_TIMEOUT_SECONDS=20
CARRIER_OFFER_TIMEOUT_SECONDS=15
# Carrier credentials are normally entered in the admin UI (stored encrypted). Optional bootstrap
# fallback as JSON. Field names are defined once official carrier API docs are supplied.
# EKART_CREDENTIALS_JSON={}
# XPRESSBEES_CREDENTIALS_JSON={}

# --- Review checks -------------------------------------------------------------------------
# Location risk check: MaxMind GeoLite2-City database (free account at maxmind.com, download
# GeoLite2-City.mmdb into ./geoip/). Lookups are local; customer IPs are never sent anywhere.
# Empty = the IP comparison is skipped (the billing-address comparison still runs).
GEOIP_CITY_DB_PATH=/app/geoip/GeoLite2-City.mmdb

# --- Alerts (see docs/operations.md) --------------------------------------------------------
# Failures that need a person (carrier auth, failed shipments, Shopify sync, stuck orders) are
# sent to every configured channel. Test with: docker compose run --rm api python -m app.alerts test
# Slack: create an "Incoming Webhook" for a channel and paste its URL.
ALERT_SLACK_WEBHOOK_URL=
# Email: comma-separated recipients plus an SMTP server (both needed).
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls
# WARNING | ERROR | CRITICAL: alerts below this level are recorded but not sent.
ALERT_MIN_SEVERITY=WARNING
# After an alert is sent, similar alerts wait this long, then go out together as one message.
ALERT_COOLDOWN_MINUTES=30

# --- Monitoring ----------------------------------------------------------------------------
# Sentry error tracking (empty = off). Customer data is never sent (no PII, no request bodies).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Bearer token for GET /metrics (Prometheus format). Empty = endpoint disabled.
METRICS_TOKEN=
# Health checks flag orders / Shopify syncs with no progress for this many minutes.
OPS_STUCK_MINUTES=30
OPS_QUEUE_BACKLOG_THRESHOLD=500

# --- Local Docker host ports (development compose only) -------------------------------------
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# API_HOST_PORT=8000
